alias hx='helix'

alias ls='eza --icons=never --group-directories-first'
alias ll='eza -l --icons=never --group-directories-first --git --time-style=relative'
alias la='eza -la --icons=never --group-directories-first --git --time-style=relative'
alias tree='eza --tree --icons=never'

alias cat='bat --style=numbers --theme=auto'
alias grep='rg --color=auto'
alias diff='diff --color=auto'
alias df='df -h'

